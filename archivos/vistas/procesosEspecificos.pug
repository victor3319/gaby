extends layout

block content1
    br
    a(href="/procesos")
        button.hm(name="boton" value="volver") Volver
    form(method="post" action="/adp" enctype="multipart/form-data")
        div
            if proceso == "recibos" || proceso == "cargarRecibos" || proceso == "cerrarR" || proceso == "cargarR"
                include procesos/adp/recibos
            if proceso == "novedades" || proceso == "cruce" || proceso == "cerrarN" || proceso == "cargarN"
                include procesos/adp/novedades
            if proceso == "undefined"
                include enConstruccion
    form(method="post" action="/e&d" enctype="multipart/form-data")
        div 
            if proceso == "seleccion" || proceso == "cerrarS" || proceso == "cargarS"
                include procesos/e&d/seleccion
            if proceso == "undefined"
                include enConstruccion
    