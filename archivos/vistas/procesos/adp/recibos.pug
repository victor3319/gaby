div.containerSp
    h2.h  Recibos
    button.hm(name="boton" value="cargarRecibos") Nuevo Recibo
    h2.h Filtrar
            
    dialog.ventana(name="respuesta" open=recibos)
        h1 Cargar recibos de Sueldo
        div.input-group
            label Legajo
            input.input(type="", name="legajo")
            br
            label Mes
            input.input(type="", name="mes")
            br
            label Año
            input.input(type="", name="ano")
            br
            label Archivo
            input.input(type="file", name="archivo")
        br
        a(href="/procesosEspecificos") 
            button.boton-ok(type= "submit" name="boton" value="cargarR") Cargar
        a(href="/procesosEspecificos") 
            button.boton-nook(type="submit", name="boton" value="cerrarR") Cerrar

    dialog(name="completar" open=completar)
        h1 Debe completar los datos obligatorio
        a(href="/procesosEspecificos") 
            button.boton-nook(type="submit", name="boton" value="cerrarR") Cerrar

    
                    
            

        

    


    