div.containerP
    h2.h  Selección y Empleo
    button.hm(name="boton" value="solicitudes") Solicitudes de Empleo
    button.hm(name="boton" value="busquedas") Búsqueda
   
//TABAS SOLICITUDES

div.containerSp(name="solicitudes" style={display : solicitudes})           
    h1.h Solicitudes de Empleo
    button.hm(name="boton" value="fCv1") Filtrar
    input.input(type="text" name="filtrocv1")
    table(name="tablaSolicitudes")
        thead 
            tr
                th #
                th Nombre
                th Apellido
                th Teléfono
                th Email
                th LinkedIn 
                th Carrera o Especialidad
                    br
                    input.filtro(type="text" data-col="0" placeholder="Filtrar...")
                th CV
                    br
                    input.filtro(type="text" data-col="0" placeholder="Filtrar...")
                th Cargo/Planta
                    br
                    input.filtro(type="text" data-col="0" placeholder="Filtrar...")
                th Fecha/Procesos
                th Acción
        tbody
        -var cantidad=0 
            each solicitante in base1
                -cantidad=cantidad+1
                tr
                    td(name="cantidad")= cantidad
                    td(name="nombres")= solicitante.nombres
                    td(name="apellidos")= solicitante.apellidos
                    td(name="telefono")= solicitante.telefono
                    td(name="correo")= solicitante.correo
                    td(name="linkedin")= solicitante.linkedIn
                    td(name="carrera")= solicitante.carrera
                    td
                        button.hmi(name="boton" value="cv"+"-"+solicitante.correo formtarget="_blank")
                            img.imgIcono(src="img/PDF.png", name="boton" value="cv"+"-"+solicitante.correo alt="Botón Acción")
                    td(name="cargo")= solicitante.cargo
                    td(name="procesos")= solicitante.procesos
                    td
                        button.hm(name="boton" value="eliminar"+"-"+solicitante.correo) Eliminar
                        button.hm(name="boton" value="editarBusqueda"+"-"+solicitante.correo) Editar
    //EDITAR SOLICITUD
    form(method="POST" action="/e&d") 
        dialog.ventana(name="editarSolicitud" open=editarSolicitud)
            h1 Edite los datos de la solicitud
            h2 Datos Básicos de la Solicitud
            div.input-group
                label Nombres
                input.input(type="", name="nombres" value=(formData && formData.nombres) || "")
                br
                label Apellidos
                input.input(type="", name="apellidos" value=(formData && formData.apellidos) || "")
                br
                label Teléfono
                input.input(type="", name="telefono" value=(formData && formData.telefono) || "")
                br
                label email
                input.input(type="", name="correo" value=(formData && formData.correo) || "")
                br
                label LinkedIn
                input.input(type="", name="linkedIn" value=(formData && formData.linkedIn) || "")
                br
                label Carrera
                input.input(type="", name="carrera" value=(formData && formData.carrera) || "")
                br
                label cv
                input.input(type="", name="tipo" value=(formData && formData.tipo) || "")
                br
                h2 Datos del Proceso de la Búsqueda
                label Cargos
                input.input(type="", name="cargo" value=(formData && formData.cargo) || "")
                br
                label Estatus
                input.input(type="", name="estatus" value=(formData && formData.estatus) || "")
                br
                h3 Procesos
                thead 
                    tr
                        th Fecha 
                        th Proceso
            a(href="/procesosEspecificos") 
                button.boton-ok(type= "submit" name="boton" value="cargarB") Cargar
            a(href="/procesosEspecificos")
                button.boton-nook(name="boton" value="solicitudes") Cerrar

                                    

//TABLAS BUSQUEDAS        

div.containerSp(name="busquedas" style={display : pBusquedas})
    h1.h Búsquedas
        form(method="POST" action="/e&d") 
            button.hm(name="boton" value="nuevaBusqueda") Agregar Busqueda
    table(name="tablabusquedas")
        thead 
            tr
                th Codigo
                th Tipo
                th Cargo
                    br
                    input.filtro(type="text" data-col="0" placeholder="Filtrar...")
                th Cliente
                    br
                    input.filtro(type="text" data-col="0" placeholder="Filtrar...")
                th Estatus
                    br
                    input.filtro(type="text" data-col="0" placeholder="Filtrar...")
                th Fecha de Inicio
                th Fecha de Cierre
                th Postulados
                th En Proceso 
                th Descartados
                th Acción
        tbody
        -var cantidad=0 
            each busqueda in tBusquedas
                -cantidad=cantidad+1
                tr
                    td(name="codigo")= busqueda.codigo
                    td(name="tipo")= busqueda.tipo
                    td(name="cargo")= busqueda.cargo
                    td(name="cliente")= busqueda.cliente
                    td(name="estatus")= busqueda.estatus
                    td(name="fInicioBusqueda")= busqueda.fInicioBusqueda
                    td(name="fCierreBusqueda")= busqueda.fCierreBusqueda
                    td(name="postulados")= busqueda.postulados
                    td(name="enProceso")= busqueda.enProceso
                    td(name="descartado")= busqueda.descartado
                    td
                        button.hm(name="boton" value="eliminarB"+"-"+busqueda.codigo) Eliminar
                        button.hm(name="boton" value="editarB"+"-"+busqueda.codigo) Editar

    //AGREGAR BUSQUEDA
    form(method="POST" action="/e&d") 
        dialog.ventana(name="agregarBusqueda" open=agregarBusqueda)
            h1 Agregue los datos de la Nueva Busqueda
            div.input-group
                label Codigo
                input.input(type="", name="codigo" value = codigoBusqueda)
                br
                label Tipo
                input.input(type="", name="tipo" value=(formData && formData.tipo) || "")
                br
                label Cargo
                input.input(type="", name="cargo" value=(formData && formData.cargo) || "")
                br
                label Cliente
                input.input(type="", name="cliente" value=(formData && formData.cliente) || "")
                br
                label Correo Cliente
                input.input(type="", name="correoCliente" value=(formData && formData.correoCliente) || "")
                br
                label Lugar de Trabajo
                input.input(type="", name="lTrabajo" value=(formData && formData.lTrabajo) || "")
                label Fecha Inicio
                input.input(type="date", name="fInicioBusqueda" value=(formData && formData.fInicioBusqueda) || "")
                br
                label Responsabilidades
                button.hm(name="boton" value="agregarResponsabilidad") Agregar
                input.input(type="", name="responsabilidadAgregada")
                h3 Lista de Responsabilidades
                ul
                    each r, i in listaResponsabilidades
                        li 
                            span= r
                            button.hm(name="boton" value="eliminarR"+"-"+i) Eliminar
                br
                
            a(href="/procesosEspecificos") 
                button.boton-ok(type= "submit" name="boton" value="cargarB") Cargar
            a(href="/procesosEspecificos")
                button.boton-nook(name="boton" value="busquedas") Cerrar


    //EDITAR BUSQUEDA
    form(method="POST" action="/e&d") 
        dialog.ventana(name="editarBusqueda" open=editarBusqueda)
            h1 Edite los datos de la Busqueda
            h2 Datos Básicos de la Búsqueda
            div.input-group
                label Tipo
                input.input(type="", name="tipo" list="listaResp" value=(formData && formData.tipo) || "")
                datalist#listaResp
                    option(value="Efectivo")
                    option(value="Agencia")
                br
                label Cargo
                input.input(type="", name="cargo" value=(formData && formData.cargo) || "")
                br
                label Cliente
                input.input(type="", name="cliente" value=(formData && formData.cliente) || "")
                br
                label Correo Cliente
                input.input(type="", name="correoCliente" value=(formData && formData.correoCliente) || "")
                br
                label Lugar de Trabajo
                input.input(type="", name="lTrabajo" list="listaResp" value=(formData && formData.lTrabajo) || "")
                datalist#listaResp
                    option(value="Matínez")
                    option(value="Escobar")
                label Fecha Inicio
                input.input(type="date", name="fInicioBusqueda" value=(formData && formData.fInicioBusqueda) || "")
                br
                label Responsabilidades
                button.hm(name="boton" value="editarResponsabilidades") Agregar
                input.input(type="", name="responsabilidadEditada")
                h3 Lista de Responsabilidades
                ul
                    each r, i in listaResponsabilidades
                        li 
                            span= r
                            button.hm(name="boton" value="eliminarR"+"-"+i) Eliminar                    
                br
                h2 Datos del Proceso de la Búsqueda
                br
                label Estatus
                input.input(type="", name="estatus" value=(formData && formData.estatus) || "")
                br
                h3 Procesos
                thead 
                    tr
                        th Fecha 
                        th Proceso


                
                
            a(href="/procesosEspecificos") 
                button.boton-ok(type= "submit" name="boton" value="modificarB") Modificar
            a(href="/procesosEspecificos")
                button.boton-nook(name="boton" value="busquedas") Cerrar

    
