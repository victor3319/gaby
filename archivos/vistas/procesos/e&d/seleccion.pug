div.containerP
    h2.h  Selección y Empleo
    button.hm(name="boton" value="solicitudes") Solicitudes de Empleo
    button.hm(name="boton" value="busquedas") Búsqueda
   
//TABAS SOLICITUDES

div.containerSp(name="solicitudes" style={display : solicitudes})           
    h1.h Solicitudes de Empleo
    h3 Link para registrar solicitdes de empleo
    a(href="https://rowa-kd8i.onrender.com/externo" target="_blank") https://rowa-kd8i.onrender.com/externo
    button.hm(name="boton" value="copiarL") 📋
    br
    div(style="text-align: right;")
        button.hm(name="boton" value="descargarS") 📥
    table(name="tablaSolicitudes")
        thead 
            tr
                th #
                th Nombre
                th Apellido
                th Teléfono
                th Email
                th LinkedIn 
                th Carrera o Especialidad
                    br
                    div.contenedor-filtro
                        input.input-filtro(type="text" data-col="0" placeholder="Palabra...")
                        button.boton-filtro(name="boton" value="fEsp") 🔍
                th CV
                    br
                    div.contenedor-filtro
                        input.input-filtro(type="text" name="filtrocv1" data-col="0" placeholder="Palabra...")
                        button.boton-filtro(name="boton" value="fCv1") 🔍
                th Cargo/Planta
                    br
                    div.contenedor-filtro
                        input.input-filtro(type="text" name="filtroCargos" data-col="0" placeholder="palabra...")
                        button.boton-filtro(name="boton" value="fCargos") 🔍
                th Fecha/Procesos
                th Acción
        tbody
        -var cantidad=0 
            each solicitante in base1
                -cantidad=cantidad+1
                tr
                    td(name="cantidad")= cantidad
                    td(name="nombres")= solicitante.nombres
                    td(name="apellidos")= solicitante.apellidos
                    td(name="telefono")= solicitante.telefono
                    td(name="correo")= solicitante.correo
                    td(name="linkedin")= solicitante.linkedIn
                    td(name="carrera")= solicitante.carrera
                    td
                        button.hmi(name="boton" value="cv"+"-"+solicitante.correo formtarget="_blank")
                            img.imgIcono(src="img/PDF.png", name="boton" value="cv"+"-"+solicitante.correo alt="Botón Acción")
                    td(name="cargo")= solicitante.cargo
                    td(name="procesos")= solicitante.procesos
                    td
                        button.hm(name="boton" value="eliminar"+"-"+solicitante.correo) ❌
                        button.hm(name="boton" value="editarSolicitud"+"-"+solicitante.correo) ✏️
    //EDITAR SOLICITUD
    form(method="POST" action="/e&d") 
        dialog.ventana(name="editarSolicitud" open=editarSolicitud)
            h1 Edite los datos de la solicitud
            h2 Datos Básicos de la Solicitud
            div.input-group
                label Nombres
                input.input(type="", name="nombres" value=(formData && formData.nombres) || "")
                br
                label Apellidos
                input.input(type="", name="apellidos" value=(formData && formData.apellidos) || "")
                br
                label Teléfono
                input.input(type="", name="telefono" value=(formData && formData.telefono) || "")
                br
                label email
                input.input(type="", name="correo" value=(formData && formData.correo) || "")
                br
                label LinkedIn
                input.input(type="", name="linkedIn" value=(formData && formData.linkedIn) || "")
                br
                label Carrera
                input.input(type="", name="carrera" value=(formData && formData.carrera) || "")
                br
                h2 Datos del Proceso de la Búsqueda
                h3 Cargos Postulados
                    button.hm(name="boton" value="agregarCargo") ➕
                input.input(type="", name="cargoAgregado")
                ul
                    each c, i in cargos
                        li 
                            span= c
                            input(type="hidden" name="cargo" value=c)
                            button.hm(name="boton" value="eliminarC"+"-"+i) ❌
                br
                label Estatus
                input.input(type="", name="estatus" value=(formData && formData.estatus) || "")
                br
                h3 Procesos
                    button.hm(type="button" onclick="agregarFila()") ➕
                table#mitabla
                    thead 
                        tr
                            th Fecha 
                            th Proceso
                            th Resultado
                            th Acción
                    tbody                            

            a(href="/procesosEspecificos") 
                button.boton-ok(type= "submit" name="boton" value="modificarS") Cargar
            a(href="/procesosEspecificos")
                button.boton-nook(name="boton" value="solicitudes") Cerrar

                                    

//TABLAS BUSQUEDAS        

div.containerSp(name="busquedas" style={display : pBusquedas})
    h1.h Búsquedas
        button.hm(name="boton" value="nuevaBusqueda") ➕
        form(method="POST" action="/e&d") 
    table(name="tablabusquedas")
        thead 
            tr
                th Codigo
                th Tipo
                th Cargo
                    br
                    div.contenedor-filtro
                        input.input-filtro(type="text" data-col="0" placeholder="Palabra...")
                        button.boton-filtro(name="boton" value="fCargoB") 🔍
                th Cliente
                    br
                    div.contenedor-filtro
                        input.input-filtro(type="text" data-col="0" placeholder="Palabra...")
                        button.boton-filtro(name="boton" value="fClienteB") 🔍
                th Estatus
                    br
                    div.contenedor-filtro
                        input.input-filtro(type="text" data-col="0" placeholder="Filtrar...")
                        button.boton-filtro(name="boton" value="fEstatus") 🔍
                th Fecha de Inicio
                th Fecha de Cierre
                th Postulados
                th En Proceso 
                th Descartados
                th Acción
        tbody
        -var cantidad=0 
            each busqueda in tBusquedas
                -cantidad=cantidad+1
                tr
                    td(name="codigo")= busqueda.codigo
                    td(name="tipo")= busqueda.tipo
                    td(name="cargo")= busqueda.cargo
                    td(name="cliente")= busqueda.cliente
                    td(name="estatus")= busqueda.estatus
                    td(name="fInicioBusqueda")= busqueda.fInicioBusqueda
                    td(name="fCierreBusqueda")= busqueda.fCierreBusqueda
                    td(name="postulados")= busqueda.postulados
                    td(name="enProceso")= busqueda.enProceso
                    td(name="descartado")= busqueda.descartado
                    td
                        button.hm(name="boton" value="eliminarB"+"-"+busqueda.codigo) ❌
                        button.hm(name="boton" value="editarB"+"-"+busqueda.codigo) ✏️
                        button.hm(name="boton" value="buscarB"+"-"+busqueda.codigo) 🔍

    //AGREGAR BUSQUEDA
    form(method="POST" action="/e&d") 
        dialog.ventana(name="agregarBusqueda" open=agregarBusqueda)
            h1 Agregue los datos de la Nueva Busqueda
            div.input-group
                label Codigo
                input.input(type="", name="codigo" value = codigoBusqueda)
                br
                label Tipo
                input.input(type="", name="tipo" value=(formData && formData.tipo) || "")
                br
                label Cargo
                input.input(type="", name="cargo" value=(formData && formData.cargo) || "")
                br
                label Cliente
                input.input(type="", name="cliente" value=(formData && formData.cliente) || "")
                br
                label Correo Cliente
                input.input(type="", name="correoCliente" value=(formData && formData.correoCliente) || "")
                br
                label Lugar de Trabajo
                input.input(type="", name="lTrabajo" value=(formData && formData.lTrabajo) || "")
                label Fecha Inicio
                input.input(type="date", name="fInicioBusqueda" value=(formData && formData.fInicioBusqueda) || "")
                br
                label Responsabilidades
                    button.hm(name="boton" value="agregarResponsabilidad") ➕
                input.input(type="", name="responsabilidadAgregada")
                h3 Lista de Responsabilidades
                ul
                    each r, i in listaResponsabilidades
                        li 
                            span= r
                            button.hm(name="boton" value="eliminarR"+"-"+i) ❌
                br
                
            a(href="/procesosEspecificos") 
                button.boton-ok(type= "submit" name="boton" value="cargarB") Cargar
            a(href="/procesosEspecificos")
                button.boton-nook(name="boton" value="busquedas") Cerrar


    //EDITAR BUSQUEDA
    form(method="POST" action="/e&d") 
        dialog.ventana(name="editarBusqueda" open=editarBusqueda)
            h1 Edite los datos de la Busqueda
            h2 Datos Básicos de la Búsqueda
            div.input-group
                label Código 
                input.input(type="", name="codigo" value=(formData && formData.codigo) || "" readonly)
                br
                label Tipo
                input.input(type="", name="tipo" list="listaResp" value=(formData && formData.tipo) || "")
                datalist#listaResp
                    option(value="Efectivo")
                    option(value="Agencia")
                br
                label Cargo
                input.input(type="", name="cargo" value=(formData && formData.cargo) || "")
                br
                label Cliente
                input.input(type="", name="cliente" value=(formData && formData.cliente) || "")
                br
                label Correo Cliente
                input.input(type="", name="correoCliente" value=(formData && formData.correoCliente) || "")
                br
                label Lugar de Trabajo
                input.input(type="", name="lTrabajo" list="listaResp" value=(formData && formData.lTrabajo) || "")
                datalist#listaResp
                    option(value="Matínez")
                    option(value="Escobar")
                label Fecha Inicio
                input.input(type="date", name="fInicioBusqueda" value=(formData && formData.fInicioBusqueda) || "")
                br
                label Responsabilidades
                    button.hm(name="boton" value="editarResponsabilidades") ➕
                input.input(type="", name="responsabilidadEditada")
                h3 Lista de Responsabilidades
                ul
                    each r, i in listaResponsabilidades
                        li 
                            span= r
                            input(type="hidden" name="listaResponsabilidades" value=r)
                            button.hm(type="submit" name="boton" value="eliminarR"+"-"+i) ❌        
                br
                label Estatus
                input.input(type="", name="estatus" value=(formData && formData.estatus) || "")               
                
            a(href="/procesosEspecificos") 
                button.boton-ok(type= "submit" name="boton" value="modificarB") Modificar
            a(href="/procesosEspecificos")
                button.boton-nook(name="boton" value="busquedas") Cerrar


script.

    //TABLA AGREGAR Y ELIMIAR DE PROCESOS DE SELECCION
  function agregarFila() {
    const tabla = document.getElementById("mitabla").getElementsByTagName("tbody")[0];
    const fila = tabla.insertRow();

    // Columna Fecha
    const celda1 = fila.insertCell(0);
    const inputFecha = document.createElement("input");
    inputFecha.name = "fechaProceso"
    inputFecha.type = "date";
    inputFecha.className = "input";
    celda1.appendChild(inputFecha);

    // Columna Proceso
    const celda2 = fila.insertCell(1);
    const selectProceso = document.createElement("select");
    selectProceso.name = "proceso";
    selectProceso.innerHTML = `
      <option value="" disabled selected>Seleccione</option>
      <option value="RRHH">Entrevista RRHH</option>
      <option value="pruebas">Pruebas</option>
      <option value="jefe">Entrevista Jefe</option>
      <option value="pruebasTecnic">Prueba Técnica</option>
      <option value="medico">Médico</option>
      <option value="ambiental">Ambiental</option>`;
    celda2.appendChild(selectProceso);

    // Columna Resultado
    const celda3 = fila.insertCell(2);
    const selectResultado = document.createElement("select");
    selectResultado.name = "resultado";
    selectResultado.innerHTML = `
      <option value="" disabled selected>Seleccione</option>
      <option value="programado">Programado</option>
      <option value="aprobado">Aprobado</option>
      <option value="rechazado">Rechazado</option>`;
    celda3.appendChild(selectResultado);

    // Columna Acción
    const celda4 = fila.insertCell(3);
    const btnEliminar = document.createElement("button");
    btnEliminar.type = "button";
    btnEliminar.className = "hm";
    btnEliminar.textContent = "❌";
    btnEliminar.onclick = function() { eliminarFila(btnEliminar); };
    celda4.appendChild(btnEliminar);
  }
    //Eliminar fila de tabla en edición de solicitud
  function eliminarFila(boton) {
    const fila = boton.closest("tr");
    fila.remove();
  }

    
