div.container
    div
        h1 Solicitud de Empleo
        h2 Datos Obligatorios (*)
        br
        h2.h *Nombres
        input.input(type="", name="nombres")
        h2.h *Apellidos
        input.input(type="", name="apellidos")
        h2.h *Teléfono
        input.input(type="", name="telefono")
        h2.h *Email
        input.input(type="", name="correo")
        h2.h *Carrera o Especialidad
        input.input(type="", name="carrera")
        h2.h *Espectativa de sueldo Bruto
        input.input(type="", name="sueldo")
        h2.h LinkedIn
        input.input(type="", name="linkedIn")
        h2.h CV *pdf
        input.input(type="file", name="archivo")
        button.hm(name="boton" value="postular") Solicitar
